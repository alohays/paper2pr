# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# PDFs are never tracked (Quarto HTML is the deployed format; handouts are exported locally)
*.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
/.quarto/

# Quarto rendered HTML (regenerable via quarto render)
# Recursive on purpose: decks live under Quarto/<genre>/, and an anchored
# `Quarto/*.html` would stop ignoring render output the moment they moved,
# which means committing a 400KB rendered deck on the next `git add`.
Quarto/**/*.html
Quarto/**/*_files/
Quarto/Figures

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# RoboTTT animation sources: copies of the NVIDIA project-page widgets that
# scripts/build_widgets.py assembles into the committed Quarto/_widgets/*.qmd.
# Local-only, not for distribution.
Quarto/papers/robottt-anim/

**/*.quarto_ipynb

# SUNY video assets (hosted via GitHub Release, not tracked in git)
Figures/talks/SUNY/videos/

# Every deck's trimmed clips and posters: Figures/<genre>/<deck>/videos/
# (written by scripts/media_prep.py, uploaded to the Release media-<deck> by
# scripts/media_release.sh). The manifest (videos.yml) and the lock file
# (videos.json) beside them ARE tracked. The fixture's copy under
# Quarto/_fixtures/video/videos/ is ignored by the same rule below.
Figures/**/videos/
Quarto/_fixtures/video/videos/

# RoboTTT task videos. The deck lists NVIDIA's CDN first and these as a local
# fallback; check_site_assets.py allows videos/*.mp4 to be missing from _site
# for exactly that reason. Untracked *and* unignored meant one `git add -A`
# would have committed 3.3 MB of them.
Quarto/videos/

# Speaker notes backup (local only, not shared).
# NOTE: gitignore does not apply to files already tracked. .speaker-notes/
# SUNY.json was committed to the public repo before this rule could bite and
# had to be removed with `git rm --cached`. If a backup ever shows up in
# `git status` as staged, it is being tracked -- untrack it, do not commit it.
.speaker-notes/

# Presenter scripts (local only — the deployed deck must not carry them)
Quarto/_script/

# Quarto project-level build artifacts
_site/
/index.html
index_files/

# GitHub Pages output (deployed via CI/CD, not tracked in git)
docs/

# SUNY script-compression working files (word counts + editing notes).
# Untracked *and* unignored is the state that invites an accidental commit
# of script material -- pick one. This picks ignored.
quality_reports/suny_script_compression/

# Fixture media and screenshots stay local: media/ holds third-party stills and
# clips, shots/ is regenerable evidence (quarto render + shoot.sh).
Quarto/_fixtures/theme-mockups/media/
Quarto/_fixtures/**/shots/
